@using System.Web
@model ShoppingCartViewModel
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/productsIndex.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shoppingCart.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/containerResponsive.css" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/forms.css" rel="stylesheet" asp-append-version="true" />

<link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<body style="background: #121212">
    <header class="header" style="margin-bottom: 70px;">
        <partial name="_HeaderPartial" />
    </header>
    @if (Model.CartItems != null)
    {
        <div class="products-and-order-container">
            <div class="cart-products-container">
                @foreach (var item in Model.CartItems)
                {
                    <div class="cart-product js-cart-product-@item.ProductID">
                        <img src="~/Img/@item.Product.Image" class="cart-product-image">
                        <div class="cart-product-info">
                            <p class="cart-product-name">@item.Product.Name</p>
                            <div class="cart-product-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= @item.Product.AverageRating)
                                    {
                                        <i class="fa-solid fa-star fa-sm" style="color: #29db47;"></i>
                                    }
                                    else if (@item.Product.AverageRating >= (i - 1) + 0.5 && @item.Product.AverageRating < i)
                                    {
                                        <i class="fa-solid fa-star-half-stroke fa-sm" style="color: #29db47;"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star fa-sm"></i>
                                    }
                                }
                            </div>
                        </div>

                        <div class="delivery-choices">
                            @foreach (var option in Model.DeliveryOptions)
                            {
                                string formattedCost = @option.Cost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                                bool isChecked = (item.ShippingOption.Equals(option.Name));

                                <div class="delivery-choice-container">
                                    <input class="delivery-option js-delivery-option" type="radio" id="@option.ID-@item.ProductID" name="delivery-options-@item.ProductID" checked="@isChecked" value="@formattedCost" onchange="calculateShipping(); updateCartItemShippingOption(@item.ProductID, @formattedCost, '@option.Name')">
                                    <label class="delivery-label" for="@option.ID-@item.ProductID">@option.Name</label>
                                </div>
                            }
                        </div>

                        <div class="item-quantity-and-price">
                            <div class="quantity-container">
                                <span class="quantity-selected">Quantity Selected</span>
                                @{
                                    double productPrice = item.Product.Price;
                                    string formattedPrice = productPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                                    <div class="quantity-selector" data-product-id="@item.ProductID" data-price="@formattedPrice">

                                        <button type="button"
                                                class="quantity-btn decrease"
                                                onclick="changeQuantity(this, -1)">
                                            <i class="fa-solid fa-minus"></i>
                                        </button>

                                        <span class="quantity-value">@item.Quantity</span>

                                        <button type="button"
                                                class="quantity-btn increase"
                                                onclick="changeQuantity(this, 1)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>

                                    </div>
                                }
                            </div>

                            <div class="prices-container">
                                @{
                                    double productTotalPrice = @item.Product.Price * @item.Quantity;
                                    string formattedTotalPrice = productTotalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                                }
                                <span class="cart-product-price">$@formattedPrice each</span>
                            </div>

                            <span class="cart-product-total-price ">Total: $<span class="product-total js-product-total-@item.ProductID">@formattedTotalPrice</span></span>
                            <button class="remove-item-button"  onclick="removeFromCart(@item.Product.ID, '@(HttpUtility.JavaScriptStringEncode(@item.Product.Name))')" id="js-remove-item-button">
                                <i class="fa-solid fa-trash"></i>
                                Remove Item
                                </button>

                        </div>
                    </div>
                }
            </div>
            <div class="order-summary-container">
                <div class="order-summary-info">
                    <p class="order-summary">Order Summary</p>
                    <div class="summary-row">
                        <div class="summary-column">
                            <p class="js-subtotal-items"></p>
                            <p class="shipping-handling">Shipping & Handling:</p>
                            <p class="estimated-tax">Estimated Tax:</p>
                        </div>
                        <div class="summary-column">
                            <p>$<span class="js-subtotal-price js-summary-price"></span></p>
                            <p class="shipping-cost js-summary-price">FREE</p>
                            <p>$<span class="tax-cost js-summary-price"></span></p>
                        </div>
                    </div>
                    <hr class="summary-hr">
                    <div class="js-order-total-before-coupon" style="position: relative"></div>
                    <div class="summary-row">
                        <p class="order-total">Order Total:</p>
                        <p style="font-size: 18px;">$<span class="order-total-price"></span></p>
                    </div>
                </div>
                <div class="summary-buttons">
                    <a class="gold-button checkout-button" href="@Url.Action("Create","Transaction")" id="checkout-link">Proceed to Checkout</a>
                    <button class="coupon-button page-button" >Enter Coupon Code</button>
                    <div class="coupon-input">
                        <input class="form-input" style="margin-bottom: 0; border-radius: 12px;" type="text" id="coupon-code">
                    </div>
                    <button id="submit-coupon">Submit Code</button>
                    <a class="clear-cart-button" style="text-decoration: none;" href="@Url.Action("ClearCart", "ShoppingCart")">Clear Cart</a>

                </div>

            </div>
        </div>
    }
    else
    {   
        <div class="container-section">
            <div class="carousel-container">
                <div class="no-items-container">
                    <h1>You have no items in your cart. Check out our most popular products!</h1>
                </div>
                <button class="carousel-btn left" onclick="scrollCarousel(this, -1)">‹</button>

                <div class="carousel-track">

                    @{
                        var popularProducts = Model.PopularProducts;

                        ProductsCardViewModel popularProductsViewModel = new ProductsCardViewModel
                        {
                            Products = popularProducts,
                            User = Model.User
                        };

                        Html.RenderPartial("_ProductsGridPartial", popularProductsViewModel);
                    }

                </div>

                <button class="carousel-btn right" onclick="scrollCarousel(this, 1)">›</button>

            </div>

        </div>
        
    }
    <div id="redirect-overlay">
        <div class="redirect-modal">
            <div class="redirect-spinner"></div>
            <p>Burning cart...</p>
        </div>
    </div>

    <div id="coupon-validation-overlay">
        <div class="redirect-modal" id="coupon-validation-modal">

            <button type="button"
                    id="close-coupon-validation"
                    class="close-coupon-validation">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="redirect-spinner" id="coupon-validation-spinner"></div>

            <p id="coupon-validation-message">
                Validating coupon...
            </p>

        </div>
    </div>

    <div id="remove-cart-item-overlay">
        <div class="redirect-modal">
            <div class="redirect-spinner"></div>
            <p>Burning cart item...</p>
        </div>
    </div>
    <partial name="_FooterPartial" />

    <script src="~/js/shoppingCart.js" asp-append-version="true"></script>
    <script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>

</body>
