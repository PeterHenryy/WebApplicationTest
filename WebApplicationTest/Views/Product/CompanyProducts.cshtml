@{
    Layout = null;
}

@model ProductDisplayViewModel

<link rel="stylesheet" href="~/css/productsIndex.css" />
<link rel="stylesheet" href="~/css/general.css" />
<link href="~/css/productsdisplay.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/responsiveContainer.css" />
<link rel="stylesheet" href="~/css/header.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

<body style="background-color: rgb(230,230,230)">
    <header class="header">
        <partial name="_HeaderPartial" />
    </header>
    <nav class="sidebar-filter">
        <p id="filter-announcement">Filter By:</p>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product")">
            <p class="filter-option">All Products</p>
        </a>
        <p class="filter-option">Sales</p>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Most Sold"})">
            <div class="option-container">

                <i class="fa-solid fa-money-bill-trend-up" style="color: #000000;"></i>
                <p class="option">Most Sold</p>
            </div>
        </a>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Most Revenue"})">
            <div class="option-container">

                <i class="fa-solid fa-money-bill-trend-up" style="color: #000000;"></i>
                <p class="option">Most Revenue</p>
            </div>
        </a>
        <p class="filter-option">Price</p>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Price", optionIdentify = 1 })">
            <div class="option-container">
                <i class="fa-solid fa-money-bill" style="color: #000000;"></i>
                <p class="option">Lowest</p>
            </div>
        </a>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Price", optionIdentify = 2 })">
            <div class="option-container">
                <i class="fa-solid fa-sack-dollar" style="color: #000000;"></i>
                <p class="option">Highest</p>
            </div>
        </a>
        <p class="filter-option">Rating</p>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Rating", optionIdentify = 1})">
            <div class="option-container">
                <i class="fa-solid fa-star fa-sm" style="color: #29db47;"></i>
                <p class="option">Highest</p>
            </div>
        </a>
        <a style="text-decoration: none;" class="option" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Rating", optionIdentify = 2})">
            <div class="option-container">
                <i class="fa-solid fa-star fa-sm" style="color: red;"></i>
                <p class="option">Lowest</p>
            </div>
        </a>
    </nav>
    <main>
        <section>
            <div class="responsive-container">
                <div class="add-product-container">
                    <a class="btn btn-success" style="font-size: 24px;" href="@Url.Action("Create", "Product")">Add Product</a>
                </div>
                <div class="products-display-grid">
                    
                    @{
                        var products = Model.Products;
                        var currentUser = Model.User;
                        ProductsCardViewModel productsViewModel = new ProductsCardViewModel
                        {
                            Products = products,
                            User = currentUser,
                            CompanyProducts = true
                        };
                        Html.RenderPartial("_ProductsGridPartial", productsViewModel);
                    }
                </div>
                <div class="pagination-container">

                    <nav aria-label="...">
                        <ul class="pagination">
                            @for (int i = 1; i <= @ViewBag.NumberOfPages; i++)
                            {

                                @if (@ViewBag.CurrentPageNumber == i)
                                {

                                    <li class="page-item active">
                                        <a class="page-link" href="#">@i<span class="sr-only">(current)</span></a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action("CompanyProducts", "Product", new {filterOption = "Page", optionIdentify = @i})">@i</a></li>
                                }
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </section>
    </main>
    <partial name="_FooterPartial" />

    <script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>
    <script src="~/js/shoppingcart.js"></script>
</body>
