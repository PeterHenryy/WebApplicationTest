@model Product

@{
    Layout = null;
}
<link href="~/css/general.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/header.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link href="~/css/create-product.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/forms.css" rel="stylesheet" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<header class="header">
    <partial name="_HeaderPartial" />
</header>

<body style="background-color: #121212">
    <div class="form-outer-container">

        <div class="form-container">
            <form asp-controller="Product" asp-action="Update" enctype="multipart/form-data">

                <div class="form-row">
                    <input hidden value="@Model.ID" asp-for="ID" />
                    <input hidden value="@Model.ReleaseDate" asp-for="ReleaseDate" />
                    <input hidden value="@Model.CompanyID" asp-for="CompanyID" />
                    <input hidden value="@Model.CategoryID" asp-for="CategoryID" />
                    <input hidden value="@Model.UserID" asp-for="UserID" />
                    <input hidden value="@Model.Image" asp-for="Image" />
                    <input hidden value="@Model.AverageRating" asp-for="AverageRating" />

                    <div class="form-group col-md-6">
                        <label for="inputEmail4">Product Name</label>
                        <input type="text" class="form-input" placeholder="Name" asp-for="Name">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="inputPassword4">Stock</label>
                        <input type="number" class="form-input" placeholder="Stock" asp-for="Stock">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Price</label>
                    <input type="text" class="form-input" placeholder="Price" asp-for="Price">
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Image</label>
                    <input type="file" class="form-input" placeholder="Image" asp-for="Image">
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Description</label>
                    <textarea class="form-input" placeholder="Description" asp-for="Description"></textarea>
                </div>
                <div class="button-container" style="margin-top: 50px;">
                    <button type="submit" class="form-button">Update Product</button>
                </div>
            </form>
        </div>
    </div>
    <partial name="_FooterPartial" />
</body>

