@{
    Layout = null;
}

@model ProductIndexViewModel

<link rel="stylesheet" href="~/css/productsIndex.css" />
<link rel="stylesheet" href="~/css/general.css" />
<link rel="stylesheet" href="~/css/containerResponsive.css" />
<link rel="stylesheet" href="~/css/header.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

<body style="background-color: rgb(220,220,220)">

    <header class="header">
        <partial name="_HeaderPartial" />
    </header>
    <main>
        <section>
            <div class="popular-announcement">
                <i class="fa-solid fa-star fa-xl" style="color: #70832a;"></i>
                <h1 class="product-h1">MOST POPULAR PRODUCTS</h1>
                <i class="fa-solid fa-star fa-xl" style="color: #70832a;"></i>
            </div>
            <div class="responsive-container">
                <div class="products-index-grid">
                    @{
                        var popularProducts = Model.GetMostPopularProducts();
                        var currentUser = Model.User;
                        ProductsCardViewModel popularProductsViewModel = new ProductsCardViewModel
                        {
                            Products = popularProducts,
                            User = currentUser
                        };
                        Html.RenderPartial("_ProductsGridPartial", popularProductsViewModel);
                    }
                   
                </div>
            </div>
        </section>
        <section>
            <div class="banner-container">
                <div class="responsive-container">
                    <a href="@Url.Action("ProductsDisplay", "Product", new {filterOption = "Category", optionIdentify = 3})">
                        <img class="banner" src="~/Img/phones.png" />
                    </a>
                </div>
            </div>

            <div class="responsive-container">
                <div class="products-index-grid">
                    @{
                        var popularCellphones = Model.GetMostPopularProducts(3);
                        currentUser = Model.User;
                        ProductsCardViewModel popularCellphonesViewModel = new ProductsCardViewModel
                        {
                            Products = popularCellphones,
                            User = currentUser
                        };
                        Html.RenderPartial("_ProductsGridPartial", popularCellphonesViewModel);
                    }
                    
                </div>
            </div>

        </section>
        <section>
            <div class="banner-container">
                <div class="responsive-container">
                    <a href="@Url.Action("ProductsDisplay", "Product", new {filterOption = "Category", optionIdentify = 2})">
                        <img class="banner" src="~/Img/leatherjackets.png" />
                    </a>
                </div>
            </div>

            <div class="responsive-container">
                <div class="products-index-grid">
                    @{
                        var popularClothes = Model.GetMostPopularProducts(2);
                        currentUser = Model.User;
                        ProductsCardViewModel popularClothesViewModel = new ProductsCardViewModel
                        {
                            Products = popularClothes,
                            User = currentUser
                        };
                        Html.RenderPartial("_ProductsGridPartial", popularClothesViewModel);
                    }
                    
                </div>
            </div>
        </section>
        <section>
            <section>
                <div class="banner-container">
                    <div class="responsive-container">
                        <a href="@Url.Action("ProductsDisplay", "Product", new {filterOption = "Category", optionIdentify = 1})">
                            <img src="~/Img/gymbanner.jpg">
                        </a>
                    </div>
                </div>
                <div class="popular-announcement">
                    <h1 class="product-h1">Popular Gym Equipment</h1>
                </div>
                <div class="responsive-container">
                    <div class="products-index-grid">
                        @{
                            var popularGymEquipment = Model.GetMostPopularProducts(1);
                            currentUser = Model.User;
                            ProductsCardViewModel popularGymEquipmentViewModel = new ProductsCardViewModel
                            {
                                Products = popularGymEquipment,
                                User = currentUser
                            };
                            Html.RenderPartial("_ProductsGridPartial", popularGymEquipmentViewModel);
                        }
                    </div>
                </div>
            </section>
        </section>
    </main>

    <script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>
    <script src="~/js/shoppingCart.js"></script>

</body>