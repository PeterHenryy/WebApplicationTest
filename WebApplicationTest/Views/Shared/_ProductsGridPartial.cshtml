@using System.Web
@model ProductsCardViewModel
<script src="~/js/site.js"></script>

@foreach (var product in Model.Products)
{
    <div class="product-card">
        <a style="text-decoration: none" class="details-link" href="@Url.Action("Details", "Product", new {productID = product.ID})">
            <div class="image-card">
                <img class="product-card-image" src="~/Img/@product.Image">
            </div>
            <hr style="width: 90%; background-color: black;" />
            <div class="product-info">
                <div class="product-name-container">
                    <h3 class="product-name">@product.Name</h3>
                </div>
                <div class="product-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= product.AverageRating)
                        {
                            <img class="star-icon" src="~/icons/star-solid.svg"> 

                        }
                        else if (product.AverageRating >= (i - 1) + 0.5 && product.AverageRating < i)
                        {
                            <img class="star-icon" src="~/icons/star-half-stroke-solid.svg" />
                        }
                        else
                        {
                            <img class="star-icon" src="/icons/star-regular.svg" />
                        }
                    }
                </div>
                <h5 class="product-category">@product.Category.Name</h5>
                <h3 class="product-price">$@product.Price</h3>
            </div>
        </a>
        @if(!Model.CompanyProducts){
            bool productHasStock = product.Stock > 0;
            <div class="product-buttons-flexbox">
                @if (Model.User.Id != 0)
                {
                    @if(productHasStock){
                        <button class="product-add-to-cart-button" id="product-add-to-cart-button-@product.ID"
                                onclick="addItemToCart(@product.ID, 1, '@(HttpUtility.JavaScriptStringEncode(product.Name))', true); updateCartItemQuantity(1);">
                           Add to Cart
                        </button>
                    }
                    else{
                        <div class="disabled-add-to-card-container">
                            <button class="product-add-to-cart-button-disabled">Add to Cart</button>
                            <div class="out-of-stock-message-container">
                                <p class="out-of-stock-message">Product out of stock!</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @if(productHasStock){
                        <button class="product-add-to-cart-button" id="product-add-to-cart-button-@product.ID" onclick="redirectToLogin('@Url.Action("Login", "AppUser")', @product.ID,1)">
                           Add to Cart
                            
                        </button>
                    }
                    else{
                        <div class="disabled-add-to-card-container">
                            <button class="product-add-to-cart-button-disabled">Add to Cart</button>
                            <div class="out-of-stock-message-container">
                                <p class="out-of-stock-message">Product out of stock!</p>
                            </div>
                        </div>
                    }
                }
                <a style="text-decoration: none" href="@Url.Action("Details", "Product", new {productID = @product.ID})" class="details-button">Details</a>
            </div>
        }
        else{
            <div class="product-buttons-column-box">
                <div class="product-buttons-flexbox">
                    <a style="font-size: 18px; padding: 10px 30px; border-radius: 7px;" class="btn btn-primary" href="@Url.Action("Update", "Product", new {productID = @product.ID})">Update</a>
                    <a style="text-decoration: none" href="@Url.Action("Details", "Product", new {productID = @product.ID})" class="details-button">Details</a>
                </div>
                <div class="product-buttons-flexbox">
                    @if (!product.Archived)
                    {
                        <a style="font-size: 18px; padding: 10px 30px; border-radius: 7px; background: black" class="btn btn-info" href="@Url.Action("ManageProductArchiving", "Product", new {productID = product.ID, option = 1})">Archive</a>
                    }
                    else
                    {
                        <a style="font-size: 18px; padding: 10px 30px; border-radius: 7px; background-color: black;" class="btn btn-success" href="@Url.Action("ManageProductArchiving", "Product", new {productID = product.ID, option = 2})">Un-Archive</a>
                    }
                </div>
            </div>
        }
    </div>
}
