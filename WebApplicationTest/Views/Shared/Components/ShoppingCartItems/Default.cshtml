@model int

<a href="@Url.Action("DisplayCartItems", "ShoppingCart")" style="text-decoration: none;">
    <div class="cart-icon-container">
        @if(Model < 100){
            <span class="cart-item-quantity">@Model</span>
        }
        else{
            <span class="cart-item-quantity">99+</span>
        }
        <i class="fa-solid fa-cart-shopping fa-2xl cart-icon" ></i>
    </div>


</a>