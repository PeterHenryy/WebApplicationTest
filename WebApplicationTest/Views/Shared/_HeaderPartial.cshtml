@using WebApplicationTest.Helpers.Enums;
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    string userID = UserManager.GetUserId(@User);
    AppUser currentUser = UserManager.FindByIdAsync(userID).Result;
    int userIntID = Convert.ToInt32(userID);
    bool isUserAdmin = User.IsInRole(UserRolesEnum.Admin.ToString());
    bool isUserSignedIn = SignInManager.IsSignedIn(User);
}

<link rel="stylesheet" href="~/css/header.css" />
<link href="~/css/productdetails.css" rel="stylesheet" />

<div class="header-items-container">
    <div class="mobile-menu" id="mobileMenu">

        <button class="mobile-menu-close"
        onclick="toggleMobileMenu()">
            <i class="fa-solid fa-xmark"></i>
        </button>
        @if (isUserSignedIn)
        {
            <div class="mobile-user-card">

                @if (currentUser.ProfilePicture == "user-solid.svg")
                {
                    <img class="mobile-user-picture"
                    src="~/icons/user-solid.svg">
                }
                else
                {
                    <img class="mobile-user-picture"
                    src="@currentUser.ProfilePicture">
                }
                <div>
                    <h5>@currentUser.UserName</h5>
                   
                    
                </div>

            </div>
                <div class="mobile-menu-section">

                    <div class="reward-points-container">

                    <p style="color: white"> <i class="fa-solid fa-bag-shopping fa-xl" style="color: white; margin-right: 5px;"></i>Reward Points</p>
                    <p style="color: rgb(231, 196, 123);">@Math.Round(currentUser.UserRewardPoints, 2) <span style="color: white;">Points</span></p>
                    </div>
                </div>

            <hr class="mobile-divider" />
        }
        @if (isUserSignedIn)
        {

            @if (isUserAdmin)
            {

                <div class="mobile-menu-section">

                    <h6>Admin Menu</h6>

                    <a href="@Url.Action("CompanyRefunds", "Refund", new { companyID = currentUser.CompanyID })">
                        <i class="fa-solid fa-rotate-left"></i>Refund Requests
                    </a>

                    <a href="@Url.Action("CompanyCoupons", "Coupon", new { companyID = currentUser.CompanyID })">
                        <i class="fa-solid fa-ticket"></i> Manage Coupons
                    </a>

                    <a href="@Url.Action("CompanyProducts", "Product", new { companyID = currentUser.CompanyID })">
                        <i class="fa-solid fa-box-open"></i> Company Products
                    </a>

                    <a href="@Url.Action("CompanyStats", "Company")">
                        <i class="fa-solid fa-chart-line"></i> Company Stats
                    </a>

                </div>
                <hr class="mobile-divider" />
            }

            <div class="mobile-menu-section">

                <h6>Menu</h6>

                <a href="@Url.Action("Index","Product")">
                    <i class="fa-solid fa-house"></i> Home
                </a>

                <a href="@Url.Action("ProductsDisplay","Product")">
                    <i class="fa-solid fa-store"></i> Products
                </a>

                <a href="@Url.Action("About","AppUser")">
                    <i class="fa-solid fa-circle-info"></i> About
                </a>

                <a href="@Url.Action("Create","Contact")">
                    <i class="fa-solid fa-comments"></i> Talk to Us
                </a>

            </div>
            <hr class="mobile-divider" />

            <div class="mobile-menu-section">

                <h6>My Account</h6>

                <a href="@Url.Action("UserTransactions", "Transaction", new { userID = userIntID })">
                    <i class="fa-solid fa-clock-rotate-left"></i> Activity
                </a>

                <a href="@Url.Action("Update", "AppUser")">
                    <i class="fa-solid fa-user-gear"></i> Update Profile
                </a>

                <a href="@Url.Action("UserCards", "CreditCard", new { userID = userIntID })">
                    <i class="fa-regular fa-credit-card"></i> Credit Cards
                </a>

                <a href="@Url.Action("UserRefunds", "Refund", new { userID = userIntID })">
                    <i class="fa-solid fa-money-bill-transfer"></i> Refunds
                </a>

                <a href="@Url.Action("UserReviews", "Review", new { userID = userIntID })">
                    <i class="fa-solid fa-star"></i> Your Reviews
                </a>

            </div>

            <hr class="mobile-divider" />

            <a asp-controller="AppUser" asp-action="Logout">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        }

        else
        {
            <div class="mobile-menu-section">

                <h6>Menu</h6>

                <a href="@Url.Action("Index","Product")">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>

                <a href="@Url.Action("ProductsDisplay","Product")">
                    <i class="fa-solid fa-store fontaw-icon"></i>
                    Products
                </a>

                <a href="@Url.Action("About","AppUser")">
                    <i class="fa-solid fa-circle-info"></i>
                    About
                </a>

                <a href="@Url.Action("Create","Contact")">
                    <i class="fa-solid fa-comments"></i>
                    Talk to Us
                </a>

            </div>
            <hr class="mobile-divider" />
            <a asp-controller="AppUser"
            asp-action="Login">
                <i class="fa-solid fa-right-to-bracket"></i> Login
            </a>

            <a asp-controller="AppUser"
            asp-action="Register">
                <i class="fa-solid fa-user-plus"></i> Register
            </a>
        }
    </div>
    <div class="mobile-menu-overlay"
    id="mobileMenuOverlay"
    onclick="toggleMobileMenu()">
    </div>
    <button class="burger-menu" onclick="toggleMobileMenu()">
        <i class="fa-solid fa-bars"></i>
    </button>
    <a href="@Url.Action("Index", "Product")">
        <img class="shop-logo" src="~/Img/flaminglogo.png" />
    </a>
    @if (isUserSignedIn)
    {
        @if (!isUserAdmin) {
            <div class="mobile-cart">
                @await Component.InvokeAsync("ShoppingCartItems")
            </div>
        }
    }
    <ul class="header-items-list desktop-nav">
        <li class="header-item"><a href="@Url.Action("Index", "Product")">Home</a></li>
        <li class="header-item"><a href="@Url.Action("ProductsDisplay", "Product")">Products</a></li>
        <li class="header-item"><a href="@Url.Action("About", "AppUser")">About</a></li>
        <li class="header-item"><a href="@Url.Action("Create", "Contact")">Contact</a></li>
    </ul>

    <form class="search-container" asp-controller="Product" asp-action="ProductsDisplay" method="get">
        <input type="hidden" name="filterOption" value="Search"/>
        <input type="text" name="searchedProduct" class="search-input" placeholder="Search for products..." required>
        <button class="search-button" type="submit"><i class="fa-solid fa-magnifying-glass glass-icon" ></i></button>
    </form>


    <div class="user-options desktop-user-options">
        @if (isUserAdmin)
        {
            <div class="options-menu-dropdown">
                <p class="options-menu-trigger">Admin</p>
                <ul class="options-menu">
                    <li><a href="@Url.Action("CompanyRefunds", "Refund", new {companyID = currentUser.CompanyID})">Refund Requests</a></li>
                    <li><a href="@Url.Action("CompanyCoupons", "Coupon", new {companyID = currentUser.CompanyID})">Manage Coupons</a></li>
                    <li><a href="@Url.Action("CompanyProducts", "Product", new {companyID = currentUser.CompanyID})">Company Products</a></li>
                    <li><a href="@Url.Action("CompanyStats", "Company")">Company Stats</a></li>
                </ul>
            </div>
        }
        @if (isUserSignedIn)
        {
            @await Component.InvokeAsync("ShoppingCartItems")
            <div class="options-menu-dropdown">
                <div class="user-profile-and-name">
                    @if (currentUser.ProfilePicture == "user-solid.svg")
                    {
                         <img class="user-profile-picture" src="~/icons/user-solid.svg"> 
                    }
                    else
                    {
                        <img class="user-profile-picture" src="@currentUser.ProfilePicture">
                    }
                    <p>@currentUser.UserName</p>
                </div>
                <ul class="options-menu">
                    <li><a href="@Url.Action("Update", "AppUser")">Update Profile</a></li>
                    <li><a href="@Url.Action("UserCards", "CreditCard", new {userID = userIntID})">Credit Cards</a></li>
                    <li><a href="@Url.Action("UserRefunds", "Refund", new {userID = userIntID})">Refunds</a></li>
                    <li><a href="@Url.Action("UserReviews", "Review", new {userID = userIntID})">Your Reviews</a></li>
                    <li><a href="@Url.Action("UserTransactions", "Transaction", new {userID = userIntID})">Activity</a></li>
                </ul>
            </div>

            <div class="reward-points-container">
                <div class="reward-points-inner-container">
                    <i class="fa-solid fa-bag-shopping fa-xl" style="color: #ffffff;"></i>
                    <span style="color: #ffffff;">@Math.Round(currentUser.UserRewardPoints, 2)</span>
                </div>
                <div class="reward-points-explanation">
                    <p class="reward-points">These are your reward points, you gain points each time you purchase products with money!</p>
                </div>
            </div>

            <form class="form-inline" asp-controller="AppUser" asp-action="Logout" style="margin: 0;">
                <button class="logout-button" type="submit">Logout</button>
            </form>
        }
        else
        {
            <ul class="header-items-list">
                <li class="header-item"><a asp-controller="AppUser" asp-action="Register">Register</a></li>
                <li class="header-item"><a asp-controller="AppUser" asp-action="Login">Login</a></li>
            </ul>
        }
    </div>
</div>  

<script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>
@if (TempData["NoProductsFoundMessage"] != null)
{
    <script type="text/javascript">
        let message = '@Html.Raw(TempData["NoProductsFoundMessage"].ToString())';
        alert(message);
    </script>
}

<script>
        function toggleMobileMenu() {

        document
            .getElementById("mobileMenu")
            .classList
            .toggle("show");

        document
            .getElementById("mobileMenuOverlay")
            .classList
            .toggle("show");
    }
</script>

