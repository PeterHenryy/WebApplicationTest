@{
    Layout = null;
    bool isLoggedIn = User.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Access Denied - The Flaming Shop</title>

    <link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessDenied.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>
</head>

<body>

    <div class="access-denied-page">

        <div class="access-denied-card">

            <div class="access-denied-icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h1>Hold Up!</h1>

            @if (isLoggedIn)
            {
                <p class="access-denied-title">
                    You don't have permission to access this page.
                </p>

                <p class="access-denied-description">
                    Your account doesn't have the required permissions to continue.
                </p>
            }
            else
            {
                <p class="access-denied-title">
                    You need to be logged in to access this page.
                </p>

                <p class="access-denied-description">
                    Sign in to your Flaming Shop account to continue.
                </p>
            }

            <div class="access-denied-actions">
                <a asp-controller="AppUser"
                   asp-action="Login"
                   class="gold-button">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Login
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="back-button">
                    <i class="fa-solid fa-house"></i>
                    Back to Shop
                </a>
            </div>

        </div>

    </div>

</body>
</html>