@model IEnumerable<CreditCard>

@{
    Layout = null;
}
<script src="https://code.jquery.com/jquery-3.6.4.min.js" ></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js" ></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.js" ></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.css"  />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/general.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com" >
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin >
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" >

<header class="header">
    <partial name="_HeaderPartial" />
</header>

<div class="page-wrapper">

    <div class="container data-table-dark">
        <div class="row">
            <div class="col-lg-12 col-12">
                <div class="row">
                    <div class="col-12">
                        <div class="div-flex">
                            <p class="data-table-title">Credit Cards</p>
                            <a class="gold-button" href="@Url.Action("Create", "CreditCard")"> <i class="fa-solid fa-plus"></i> Add a Credit Card</a>
                        </div>
                        <table id="app-data-table" class="table table-striped">
                            <thead class="data-table-headers">
                                <tr>
                                    <th>Card Number</th>
                                    <th>Name On Card</th>
                                    <th>CVV</th>
                                    <th>Expiry</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in @Model)
                                {
                                    var last4 = card.CardNumber.Length >= 4
                                    ? card.CardNumber.Substring(card.CardNumber.Length - 4)
                                    : card.CardNumber;
                                    <tr>
                                        <td>💳 •••• •••• •••• @last4</td>
                                        <td>@card.NameOnCard</td>
                                        <td>@card.CVV</td>
                                        <td>@card.Expiry</td>
                                        <td> <a class="destructive-action-button" href="@Url.Action("Delete", "CreditCard", new {cardID = card.ID})">Remove</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        $('#app-data-table').DataTable();
    });
</script>
<partial name="_FooterPartial" />
