@model CreditCardViewModel
@{
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/general.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/forms.css" rel="stylesheet" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com" >
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin >
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" >


<body style="background: #121212">
    <header class="header">
        <partial name="_HeaderPartial" />
    </header>   
   
    <div class="form-outer-container">
        <div class="form-container" style="justify-content: start; height: 620px;">
            <form asp-controller="CreditCard" asp-action="Create">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="inputEmail4">Name on Card</label>
                        <input type="text" class="form-input" placeholder="Name" asp-for="@Model.CreditCard.NameOnCard" required>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="inputPassword4">Card Number</label>
                        <input type="number" class="form-input" placeholder="Card Number" asp-for="@Model.CreditCard.CardNumber" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Expiry</label>
                    <input type="month" class="form-input" placeholder="Expiry" asp-for="@Model.CreditCard.Expiry" required>
                </div>
                <div class="form-group">
                    <label for="inputAddress2">CVV</label>
                    <input type="number" class="form-input" placeholder="CVV" asp-for="@Model.CreditCard.CVV" required>
                </div>
                <div class="button-container" style="margin-top: 50px;">
                    <button type="submit" class="form-button">Add Credit Card</button>
                </div>

            </form>
        </div>
    </div>
    

    <partial name="_FooterPartial" />
</body>

