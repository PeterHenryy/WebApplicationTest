@{
    ViewData["Title"] = "Welcome | The Flaming Shop";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/disclaimer.css" rel="stylesheet" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    
</head>

<body>
    <main class="welcome-card">
        <header class="brand">
            <i class="fa-solid fa-fire-flame-curved brand-icon"
               aria-hidden="true"></i>

            <p class="brand-name">THE FLAMING SHOP</p>

            <span class="brand-subtitle">
                INDEPENDENT PERSONAL PROJECT
            </span>
        </header>

        <div class="separator"></div>

        <h1 class="welcome-title">Welcome to the project</h1>

        <p class="intro">
            This website is a personal software development and portfolio
            project created for educational and demonstration purposes.
        </p>

        <section class="disclaimer-details"
                 aria-label="Project disclaimer">
            <p>
                <strong>This is not a real online store.</strong>
                No real purchases or payments are accepted, and no products
                are offered for sale through this website.
            </p>

            <p>
                The project is independently developed and is not affiliated
                with, endorsed by, or sponsored by any third-party brands
                that may be referenced. All third-party trademarks belong
                to their respective owners.
            </p>
        </section>

        <aside class="info-panel">
            <i class="fa-solid fa-circle-info info-icon"
               aria-hidden="true"></i>

            <div>
                <h2>Demonstration only</h2>
                <p>
                    Please do not enter real payment details or sensitive
                    personal information. Any checkout or payment features
                    are for demonstration purposes only.
                </p>
            </div>
        </aside>

        <a id="enter-store"
           class="enter-button"
           asp-controller="Product"
           asp-action="Index">
            ENTER THE FLAMING SHOP
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>

        <p class="footer-note">
            A personal project built for learning and demonstration.
        </p>
    </main>

    <script>
        (() => {
            const acknowledgementKey = 'flamingShopDisclaimerAcknowledged';

            try {
                if (sessionStorage.getItem(acknowledgementKey) === 'true') {
                    window.location.replace(
                        '@Url.Action("Index", "Product")'
                    );
                    return;
                }
            } catch {
            }

            document.getElementById('enter-store')
                .addEventListener('click', () => {
                    try {
                        sessionStorage.setItem(acknowledgementKey, 'true');
                    } catch {
                        // Navigation still works if storage is unavailable.
                    }
                });
        })();
    </script>
</body>
</html>
