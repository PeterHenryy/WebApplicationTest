@model AppUser

<link href="~/css/footer.css" rel="stylesheet" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">


<form asp-controller="AppUser" asp-action="RegisterAdmin">

  <div class="form-row">
    <div class="form-group col-md-6">
      <label for="inputEmail4">Admin Name</label>
      <input type="text" class="form-control" placeholder="Admin Name" asp-for="UserName" required>
    </div>
    <div class="form-group col-md-6">
      <label for="inputPassword4">Email</label>
            <input type="text" class="form-control" placeholder="Email" asp-for="Email" required>
    </div>
  </div>
  <div class="form-group">
    <label for="inputAddress2">Password</label>
        <input type="password" class="form-control" placeholder="Password" asp-for="Password" required>
  </div>
  <button type="submit" class="btn btn-primary">Register</button>
</form>
