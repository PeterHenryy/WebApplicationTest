@model AppUser
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/loginForm.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">


<div class="login-form-container">
    <h1>Add a new Admin!</h1>
    <form asp-controller="AppUser" asp-action="RegisterAdmin">

      <div class="form-row">
        <div class="form-group col-md-6">
          <input type="text" placeholder="Admin Name" asp-for="UserName" required>
        </div>
        <div class="form-group col-md-6">
                <input type="text" placeholder="Email" asp-for="Email" required>
        </div>
      </div>
      <div class="form-group">
        <input type="password" placeholder="Password" asp-for="Password" required>
      </div>
        <button type="submit" class="register-button">Register</button>
    </form>
</div>
