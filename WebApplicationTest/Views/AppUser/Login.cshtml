@{
    Layout = null;
}
@model AppLogin

<link rel="stylesheet" href="~/css/loginForm.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin >
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<div class="login-form-container">
    <div class="logo-container">

        <img src="/Img/FlamingShopLogo.png" class="login-logo">
    </div>
    <h1>Welcome Back</h1>
    <p class="login-subtitle">
        Sign in to continue shopping.
    </p>
    <form id="loginForm" asp-controller="AppUser" asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["returnUrl"]" />
        <input type="hidden" name="cartItemQuantity" value="@ViewData["cartItemQuantity"]" />
        <input type="hidden" name="cartItemProductID" value="@ViewData["cartItemProductID"]" />
        <input type="hidden" name="adminLogin" id="adminLogin" value="false" />

        <input type="text" placeholder="Username" asp-for="Username" required />
        <input type="password" placeholder="Password" asp-for="Password" required />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-login-container">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div asp-validation-summary="All" class="error-login"></div>
            </div>
        }

        <button type="submit">Login</button>

        <input type="button" class="register-button" value="Register" onclick="window.location.href='@Url.Action("Register", "AppUser")';" />

        <input type="button" class="register-button" value="Admin Login" onclick="setAdminLoginAndSubmit();" />
    </form>
</div>

<script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous" asp-append-version="true"></script>
<script>
    function setAdminLoginAndSubmit() {
        document.getElementById('adminLogin').value = 'true';
        document.getElementById('loginForm').submit();
    }
</script>
