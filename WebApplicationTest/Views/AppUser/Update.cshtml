@model AppUser
@{
    Layout = null;
}
<link href="~/css/general.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/header.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/forms.css" rel="stylesheet" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com" >
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin >
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" >

<body style="background: #121212">
    <header class="header">
        <partial name="_HeaderPartial" />
    </header>
    <div class="form-outer-container">

        <div class="form-container">
            <form asp-controller="AppUser" asp-action="Update" enctype="multipart/form-data">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="inputEmail4">FirstName</label>
                        <input type="text" class="form-input" placeholder="FirstName" value="@Model.FirstName" asp-for="FirstName">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="inputPassword4">LastName</label>
                        <input type="text" class="form-input" placeholder="LastName" value="@Model.LastName" asp-for="LastName">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Password</label>
                    <input type="password" class="form-input" placeholder="Password" value="@Model.Password" asp-for="Password">
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Phone Number</label>
                    <input type="text" class="form-input" placeholder="Phone Number" value="@Model.PhoneNumber" asp-for="PhoneNumber">
                </div>
                <div class="form-group">
                    <label style="margin-right: 7px;" for="inputAddress2">Profile Picture</label>
                    @if (Model.ProfilePicture == "user-solid.svg")
                    {
                        <img style="width: 30px; border-radius: 50%;" src="~/icons/user-solid.svg" />
                    }
                    else
                    {
                        <img style="width: 30px; border-radius: 50%;" src="@Model.ProfilePicture" />
                    }
                    <input style="margin-top: 10px;" type="file" class="form-input" placeholder="Profile Picture" asp-for="ProfilePicture">
                </div>
                <div class="form-group">
                    <label for="inputAddress2">UserName</label>
                    <input type="text" class="form-input" placeholder="UserName" value="@Model.UserName" asp-for="UserName">
                </div>
                <div class="form-group">
                    <label for="inputAddress2">Email</label>
                    <input type="text" class="form-input" placeholder="Email" value="@Model.Email" asp-for="Email">
                </div>
                <div class="button-container">
                    <button type="submit" class="form-button">
                        Update Profile
                    </button>
                </div>
            </form>
        </div>
    </div>

    <partial name="_FooterPartial" />
</body>
