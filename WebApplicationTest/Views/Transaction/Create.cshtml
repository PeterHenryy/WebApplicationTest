@model TransactionViewModel
@{
    Layout = null;
}

<link href="~/css/header.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/general.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link href="~/css/transaction-create.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/forms.css" rel="stylesheet" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<body style="background: #121212">

    <header class="header">
        <partial name="_HeaderPartial" />
    </header>

    <main class="main-container">

        <div class="form-and-product-container">
            <div class="purchase-summary">
                <p class="purchase-announcement">You are purchasing:</p>
                <div class="summary-products">
                    @foreach (CartItem item in Model.CartItems)
                    {
                        <div class="summary-product-container">
                            <div class="summary-product-category-container">
                                @{
                                    string categoryIcon = Model.GetSummaryProductCategory(item.Product.CategoryID) + "Icon.svg";
                                }
                                <img class="summary-product-category" src="~/icons/@categoryIcon" />
                            </div>
                            <div class="summary-product-info">
                                @{
                                    string summaryItemCost = (item.Product.Price * item.Quantity).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-us"));
                                    string itemQuantity = $"(x{@item.Quantity})";
                                }
                                <p class="summary-product-name-quantity product-name">@item.Product.Name @itemQuantity</p>
                                <p class="summary-product-price">@summaryItemCost</p>
                            </div>
                        </div>
                    }
                </div>
                <hr style="background-color: black; width: 90%" />
                <div class="summary-product-container">
                    <div class="summary-product-tax-container">
                        <i class="fa-solid fa-coins fa-2xl" style="color: rgb(231, 196, 123);"></i>
                    </div>
                    <div class="summary-product-info">
                        <p class="products-tax">Tax</p>
                        <p class="summary-product-tax">@Model.TransactionTax.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-us"))</p>
                    </div>
                </div>
                <p class="summary-product-total">Total: </p>
                <div class="transaction-total-display">
                    <p class="transaction-total">@Model.Transaction.Total.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-us"))</p>
                    <p class="transaction-total">or</p>
                    @{
                        double transactionPointsCost = Model.Transaction.Total * 5;
                    }
                    <p class="transaction-total">@transactionPointsCost Points</p>

                </div>
            </div>
            <div class="form-container" style="border-top-left-radius: 0; border-bottom-left-radius: 0; width: 100%;">

                <form class="transaction-form" asp-controller="Transaction" asp-action="Create" id="transactionForm">
                    <input type="hidden" asp-for="@Model.Transaction.CouponCode" />
                    <input type="hidden" asp-for="@Model.Transaction.CouponPercentage" />
                    <input type="hidden" asp-for="@Model.Transaction.Total" id="transactionTotal" value="@Model.Transaction.Total" />
                    <div class="info-row">
                        <input asp-for="Transaction.FirstName" class="form-input" id="firstname" placeholder="First Name" required />
                        <input asp-for="Transaction.LastName" class="form-input" id="lastname" placeholder="Last Name" required />
                    </div>

                    <div class="info-row">
                        <input asp-for="Transaction.Email" class="form-input" type="email" id="email" placeholder="Email" required />
                    </div>
                    <div class="info-row">
                        <input asp-for="Transaction.PhoneNumber" class="form-input" id="phonenumber" placeholder="Phone Number" required />
                    </div>
                    <div class="info-row">
                        <input asp-for="Transaction.Address" class="form-input" id="address" placeholder="Address" required />
                    </div>
                    <div class="info-row">
                        <input asp-for="Transaction.City" class="form-input" id="city" placeholder="City" required />
                    </div>
                    <div class="info-row">
                        <input asp-for="Transaction.State" class="form-input" id="state" placeholder="State" required />
                        <input asp-for="Transaction.Zip" class="form-input" id="zip" placeholder="Zip" required />
                    </div>
                    <div class="payment-methods-container">
                        <label id="payment-method-label" for="Transaction.PaymentType">Choose Payment Method</label>

                        <div class="payment-options">
                            <div class="card-payment-option">
                                <input type="radio" class="payment-method-radio js-credit-card-radio" id="creditcard" name="Transaction.PaymentType" value="CreditCard" />
                                <label class="payment-method" for="creditcard">Credit Card</label>
                            </div>
                            <div id="credit-card-container">
                                @if (Model.UserCards.Count() > 0)
                                {
                                    <div class="info-row">
                                        <select class="credit-card-selector"
                                                id="creditCardSelect"
                                                asp-for="ChosenCardID">

                                            <option value="">Use a new card</option>

                                            @foreach (var card in Model.UserCards)
                                            {
                                                var last4 = card.CardNumber.Length >= 4
                                                ? card.CardNumber.Substring(card.CardNumber.Length - 4)
                                                : card.CardNumber;

                                                <option value="@card.ID">
                                                    💳 •••• •••• •••• @last4
                                                </option>
                                            }

                                        </select>
                                    </div>
                                }
                                <div class="credit-card-form">
                                    <div class="info-row">
                                        <input asp-for="UserNewCard.NameOnCard"
                                               class="form-input"
                                               placeholder="Name on Card"
                                               required />

                                        <input asp-for="UserNewCard.CardNumber"
                                               class="form-input"
                                               type="text"
                                               inputmode="numeric"
                                               maxlength="19"
                                               placeholder="Card Number"
                                               autocomplete="cc-number"
                                               required />
                                    </div>

                                    <div class="info-row">
                                        <input asp-for="UserNewCard.Expiry"
                                               class="form-input"
                                               type="month"
                                               required />

                                        <input asp-for="UserNewCard.CVV"
                                               class="form-input"
                                               type="text"
                                               inputmode="numeric"
                                               maxlength="3"
                                               placeholder="CVV"
                                               required />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="payment-options">
                            <div class="points-payment-option">
                                <input type="radio" class="payment-method-radio js-points-radio" id="rewardpoints" name="Transaction.PaymentType" value="RewardPoints" />
                                <label class="payment-method" for="rewardpoints">Reward Points</label>
                            </div>
                        </div>
                    </div>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="form-error-container">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div asp-validation-summary="All" class="form-error"></div>
                        </div>
                    }
                    <button class="gold-button" style="width: 100%; font-size: 30px;" type="submit">Purchase</button>
                </form>

            </div>

        </div>
    </main>
    <partial name="_FooterPartial" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kit.fontawesome.com/8da1ba04bb.js" crossorigin="anonymous"></script>
    <script src="~/js/transaction.js" asp-append-version="true"></script>
   
</body>

