@model IEnumerable<Coupon>

@{
    Layout = null;
}
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link href="~/css/general.css" rel="stylesheet" />
<link href="~/css/footer.css" rel="stylesheet" />

<div class="page-wrapper">

    <header class="header">
        <partial name="_HeaderPartial" />
    </header>

    <div class="container data-table-dark">
        <div class="row">
            <div class="col-lg-12 col-12">
                <div class="row">
                    <div class="col-12">
                        <div class="div-flex">
                            <p class="data-table-title">Company Coupons</p>
                            <a class="gold-button" href="@Url.Action("Create", "Coupon")"><i class="fa-solid fa-plus"></i> Add a New Coupon</a>
                        </div>
                        <table id="app-data-table" class="table table-striped">
                            <thead class="data-table-headers">
                                <tr>
                                    <th>ID</th>
                                    <th>Discount Percentage</th>
                                    <th>Code</th>
                                    <th>Active</th>
                                    <th>Quantity</th>
                                    <th>Product Name</th>
                                    <th>Category Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var coupon in @Model)
                                {
                                    <tr>
                                        <td>@coupon.ID</td>
                                        <td>@coupon.DiscountPercentage%</td>
                                        <td>@coupon.Code</td>
                                        <td>@coupon.Active</td>
                                        <td>@coupon.Quantity</td>
                                        <td>@(coupon.Product != null ? @coupon.Product.Name : "N/A")</td>
                                        <td>@(coupon.Category != null ? @coupon.Category.Name : "N/A")</td>
                                        <td><a class="btn btn-danger" href="@Url.Action("Delete", "Coupon", new {couponID = coupon.ID})">Delete</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="_FooterPartial" />
</div>

<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        $('#app-data-table').DataTable();
    });
</script>




